# FastApiWebAdmin-Pro 后端配置
# 复制本文件为 env/.env 后修改（通过 ENVIRONMENT 区分环境）

# dev | prod | test
ENVIRONMENT=dev

# ---------- 服务配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8085
DEBUG=true
RELOAD=true
API_PREFIX=/api

# ---------- 文档（Swagger/ReDoc） ----------
TITLE=FastApiWebAdmin-Pro Application
VERSION=2.0.0
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# ---------- 数据库（PostgreSQL 推荐） ----------
SQL_DB_ENABLE=true
DATABASE_TYPE=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=Rebort
DATABASE_NAME=fastapiwebadmin-pro
# 可选：直接写异步连接串，设置后覆盖上面分项
# SQL_DATABASE_URI=postgresql+asyncpg://postgres:Rebort@127.0.0.1:5432/fastapiwebadmin-pro

# 生产改表请用 Alembic，并设为 false
AUTO_CREATE_TABLES=true
AUTO_SEED_DATA=true

# ---------- Redis配置 ----------
REDIS_ENABLE=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URI=redis://127.0.0.1:6379/0

# ---------- 认证 ----------
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CAPTCHA_ENABLE=true
CAPTCHA_EXPIRE_SECONDS=60

# ---------- 邮件（忘记密码邮箱验证码，需配置真实 SMTP） ----------
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDR=
EMAIL_FROM_NAME=FastApiWebAdmin-Pro
EMAIL_USE_SSL=true
EMAIL_CODE_EXPIRE_SECONDS=120

# ---------- 静态资源（离线 Swagger/ReDoc） ----------
STATIC_ENABLE=true
STATIC_URL=/static

# ---------- 文件上传 / 对象存储 ----------
# local | aliyun_oss | tencent_cos | qiniu | minio
UPLOAD_STORAGE_TYPE=local
UPLOAD_MAX_SIZE_MB=100
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,webp,svg,ico,pdf,doc,docx,xls,xlsx,zip,rar,7z,mp4,mp3
# 留空则使用 backend/app/files
UPLOAD_LOCAL_PATH=
UPLOAD_URL_PREFIX=/api/files
# 阿里云 OSS
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_DOMAIN=
# 腾讯云 COS
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_DOMAIN=
# 七牛云
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

# ---------- 演示模式（禁止任何读写操作） ----------
DEMO=false
PLUGIN_PREFIX=fastadmin_

# ---------- 生产环境示例（同一文件内改 ENVIRONMENT=prod 并调整下列项） ----------
# ENVIRONMENT=prod
# DEBUG=false
# DEMO=false
# SECRET_KEY=请替换为随机长字符串
# AUTO_SEED_DATA=false
